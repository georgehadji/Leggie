# Leggie Environment Configuration
# Copy to .env and set your OpenRouter API key

# OpenRouter — single API key for all LLM providers
LEGGIE_LLM__OPENROUTER_API_KEY="sk-or-v1-your-key-here"
LEGGIE_LLM__OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
LEGGIE_LLM__OPENROUTER_DEFAULT_MODEL="google/gemini-2.5-flash"

# Cascade / Router
LEGGIE_CASCADE__RULES_PATH="config/routes.yaml"
LEGGIE_CASCADE__CONFIDENCE_FLOOR=0.6

# Budget Guard
LEGGIE_BUDGET__MAX_TOKENS_PER_RUN=500000
LEGGIE_BUDGET__MAX_COST_PER_RUN=5.0

# Retrieval
LEGGIE_RETRIEVAL__EMBED_MODEL="spyrosbriakos/greek_legal_bert_v2"

# Ingest
LEGGIE_INGEST__MAX_FILE_SIZE_MB=50

# Database
LEGGIE_DB__URL="sqlite:///leggie.db"

# Application
LEGGIE_DEBUG=false
LEGGIE_LOG_LEVEL="INFO"
LEGGIE_SEED=42
