# Leggie Environment Configuration
# Copy to .env and set your OpenRouter API key

# OpenRouter — single API key for all LLM providers
LEGGIE_LLM__OPENROUTER_API_KEY="sk-or-v1-your-key-here"
LEGGIE_LLM__OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
LEGGIE_LLM__OPENROUTER_DEFAULT_MODEL="google/gemini-2.5-flash"
# Premium default is x-ai/grok-4.5 (set in config/routes.yaml and router defaults)

# Cascade / Router
LEGGIE_CASCADE__RULES_PATH="config/routes.yaml"
LEGGIE_CASCADE__CONFIDENCE_FLOOR=0.6

# Budget Guard
# Token cap is a hard safety ceiling only; keep it well above the cost-cap
# runway (default 20,000,000).  Setting it too low recreates the historical
# 500k-token budget-block incident.
LEGGIE_BUDGET__MAX_TOKENS_PER_RUN=20000000
LEGGIE_BUDGET__MAX_COST_PER_RUN=5.0

# Retrieval — EXPERIMENTAL: not consumed by the analysis pipeline yet.
# LEGGIE_RETRIEVAL__EMBED_MODEL="spyrosbriakos/greek_legal_bert_v2"

# Ingest
LEGGIE_INGEST__MAX_FILE_SIZE_MB=50

# Database
# NOTE: single underscore here, unlike every other section above. PersistenceSettings'
# own env_prefix is "LEGGIE_DB_" (its Python field name on Settings is "persistence",
# not "db", so the double-underscore nested form other sections use does not apply
# here — LEGGIE_DB__URL is silently ignored; see config/settings.py PersistenceSettings).
LEGGIE_DB_URL="sqlite:///leggie.db"

# Reasoner — Multi-model deliberative analysis (opt-in)
# Set LEGGIE_REASONER__ENABLED=true to activate the deliberative pipeline.
# LEGGIE_REASONER__HOME must point to the Reasoner repository for auto-start.
# LEGGIE_REASONER__API_KEY is the ADMIN_API_KEY from Reasoner (secret).
LEGGIE_REASONER__ENABLED=false
LEGGIE_REASONER__HOME=""
LEGGIE_REASONER__BASE_URL="http://localhost:8003"
LEGGIE_REASONER__API_KEY=""
LEGGIE_REASONER__AUTOSTART=true
LEGGIE_REASONER__STARTUP_TIMEOUT=60
LEGGIE_REASONER__REQUEST_TIMEOUT=300
LEGGIE_REASONER__STAGE1_PRESET="multi-perspective-premium"
LEGGIE_REASONER__STAGE2_PRESET="subagent-premium"
LEGGIE_REASONER__PERSPECTIVE="neutral"

# Application
LEGGIE_DEBUG=false
LEGGIE_LOG_LEVEL="INFO"
LEGGIE_SEED=42
